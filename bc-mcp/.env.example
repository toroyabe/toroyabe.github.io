# Microsoft Business Central — OAuth 2.0 client credentials
# 把這個檔複製成 .env 再填入真正的值。.env 已被 .gitignore 排除，不會 commit。

# Entra ID (Azure AD) 租戶 ID，GUID 格式，例如 11111111-2222-3333-4444-555555555555
# 也可以用網域，例如 contoso.onmicrosoft.com
BC_TENANT_ID=

# 應用程式註冊的 Application (client) ID（GUID）
BC_CLIENT_ID=

# 應用程式註冊的 client secret 值
BC_CLIENT_SECRET=

# BC 環境名稱，例如 Production 或 Sandbox（大小寫需與 BC 後台一致）
BC_ENVIRONMENT=Production

# （選填）預設公司名稱，例如 "My Company"。留空時工具會列出所有公司讓你挑。
BC_DEFAULT_COMPANY=

# （選填）若要呼叫自訂 API page，改用對應的 publisher/group/version；
# 預設使用 BC 標準 API（api/v2.0）。
BC_API_ROUTE=v2.0
